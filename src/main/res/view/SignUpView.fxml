<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="view.SignUpViewController"
            style="-fx-background-color: #0a1f1f; -fx-font-family: 'Plus Jakarta Sans';">

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true"
                    vbarPolicy="AS_NEEDED" hbarPolicy="NEVER"
                    style="-fx-background: transparent; -fx-background-color: transparent;">
            <VBox alignment="CENTER" spacing="20"
                  style="-fx-padding: 32 80 80 80;"
                  maxWidth="Infinity">

                <!-- LOGO -->
                <ImageView fx:id="logoImage"
                           fitWidth="200" fitHeight="80"
                           preserveRatio="true"/>

                <!-- SUBTITLE -->
                <Label text="Selamat datang!"
                       style="-fx-text-fill: #c8e6c9; -fx-font-size: 16;"/>

                <!-- FORM -->
                <VBox spacing="12" maxWidth="580" prefWidth="580">

                    <!-- NIK -->
                    <Label text="Nomor Induk Karyawan" style="-fx-text-fill: white; -fx-font-size: 13;"/>
                    <TextField fx:id="fieldNik" promptText="18234567890" maxWidth="Infinity"
                               style="-fx-background-color: #132929; -fx-text-fill: white; -fx-prompt-text-fill: #5a8a8a; -fx-background-radius: 8; -fx-padding: 14 16; -fx-font-size: 14;"/>

                    <!-- NAMA -->
                    <Label text="Nama Lengkap" style="-fx-text-fill: white; -fx-font-size: 13;"/>
                    <TextField fx:id="fieldNama" promptText="Nama lengkap..." maxWidth="Infinity"
                               style="-fx-background-color: #132929; -fx-text-fill: white; -fx-prompt-text-fill: #5a8a8a; -fx-background-radius: 8; -fx-padding: 14 16; -fx-font-size: 14;"/>

                    <!-- USERNAME -->
                    <Label text="Username" style="-fx-text-fill: white; -fx-font-size: 13;"/>
                    <TextField fx:id="fieldUsername" promptText="Username..." maxWidth="Infinity"
                               style="-fx-background-color: #132929; -fx-text-fill: white; -fx-prompt-text-fill: #5a8a8a; -fx-background-radius: 8; -fx-padding: 14 16; -fx-font-size: 14;"/>

                    <!-- PASSWORD & KONFIRMASI SIDE-BY-SIDE -->
                    <HBox spacing="12">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Password" style="-fx-text-fill: white; -fx-font-size: 13;"/>
                            <StackPane>
                                <PasswordField fx:id="fieldPassword" promptText="Password" maxWidth="Infinity"
                                               style="-fx-background-color: #132929; -fx-text-fill: white; -fx-prompt-text-fill: #5a8a8a; -fx-background-radius: 8; -fx-padding: 14 16; -fx-font-size: 14;"/>
                                <TextField fx:id="fieldPasswordVisible" promptText="Password"
                                           visible="false" managed="false" maxWidth="Infinity"
                                           style="-fx-background-color: #132929; -fx-text-fill: white; -fx-prompt-text-fill: #5a8a8a; -fx-background-radius: 8; -fx-padding: 14 16; -fx-font-size: 14;"/>
                                <Button fx:id="btnTogglePassword" text="👁" onAction="#togglePassword"
                                        style="-fx-background-color: transparent; -fx-text-fill: #5a8a8a; -fx-cursor: hand;"
                                        StackPane.alignment="CENTER_RIGHT"/>
                            </StackPane>
                        </VBox>

                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Konfirmasi Password" style="-fx-text-fill: white; -fx-font-size: 13;"/>
                            <StackPane>
                                <PasswordField fx:id="fieldKonfirmasi" promptText="Konfirmasi password" maxWidth="Infinity"
                                               style="-fx-background-color: #132929; -fx-text-fill: white; -fx-prompt-text-fill: #5a8a8a; -fx-background-radius: 8; -fx-padding: 14 16; -fx-font-size: 14;"/>
                                <TextField fx:id="fieldKonfirmasiVisible" promptText="Konfirmasi password"
                                           visible="false" managed="false" maxWidth="Infinity"
                                           style="-fx-background-color: #132929; -fx-text-fill: white; -fx-prompt-text-fill: #5a8a8a; -fx-background-radius: 8; -fx-padding: 14 16; -fx-font-size: 14;"/>
                                <Button fx:id="btnToggleKonfirmasi" text="👁" onAction="#toggleKonfirmasi"
                                        style="-fx-background-color: transparent; -fx-text-fill: #5a8a8a; -fx-cursor: hand;"
                                        StackPane.alignment="CENTER_RIGHT"/>
                            </StackPane>
                        </VBox>
                    </HBox>

                    <!-- PERAN -->
                    <Label text="Peran" style="-fx-text-fill: white; -fx-font-size: 13;"/>
                    <ComboBox fx:id="combPeran" promptText="Pilih peran..." maxWidth="Infinity"
                              prefHeight="49"
                              style="-fx-background-color: #132929; -fx-background-radius: 8; -fx-text-fill: white; -fx-padding: 6 16;"/>

                </VBox>

                <!-- TOMBOL DAFTAR -->
                <Button text="Daftar" fx:id="btnDaftar" maxWidth="580" prefWidth="580"
                        onAction="#klikDaftar"
                        style="-fx-background-color: #00e5a0; -fx-text-fill: #0a1f1f; -fx-font-weight: bold; -fx-background-radius: 24; -fx-padding: 16; -fx-font-size: 15; -fx-cursor: hand;"/>

                <!-- LINK LOGIN -->
                <HBox alignment="CENTER" spacing="4">
                    <Label text="Sudah punya akun?" style="-fx-text-fill: #5a8a8a; -fx-font-size: 13;"/>
                    <Label text="Login" fx:id="linkLogin" onMouseClicked="#klikLogin"
                           style="-fx-text-fill: #00e5a0; -fx-font-size: 13; -fx-cursor: hand; -fx-underline: true;"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>