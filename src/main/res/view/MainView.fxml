<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="view.MainViewController"
            style="-fx-background-color: #0a1f1f; -fx-font-family: 'Plus Jakarta Sans';"
            prefWidth="1280" prefHeight="900">

    <!-- SIDEBAR -->
    <left>
        <VBox prefWidth="210" prefHeight="900"
              style="-fx-background-color: #061414;">

            <!-- LOGO -->
            <HBox alignment="CENTER" style="-fx-padding: 128 0 16 0;">
                <ImageView fx:id="logoImage"
                           fitWidth="180" fitHeight="60"
                           preserveRatio="true"/>
            </HBox>

            <!-- SPACER ATAS -->
            <Region VBox.vgrow="ALWAYS"/>

            <!-- MENU ITEMS -->
            <VBox spacing="4" style="-fx-padding: 0 16 0 16;">

                <Button fx:id="btnDashboard"
                        maxWidth="Infinity"
                        onAction="#navigasiDashboard"
                        style="-fx-background-color: transparent; -fx-background-radius: 8; -fx-padding: 12 16; -fx-cursor: hand;">
                    <graphic>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <ImageView fx:id="iconDashboard"
                                       fitWidth="20" fitHeight="20"
                                       preserveRatio="true"/>
                            <Label text="Dashboard"
                                   style="-fx-text-fill: white; -fx-font-size: 14;"/>
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="btnProduk"
                        maxWidth="Infinity"
                        onAction="#navigasiProduk"
                        style="-fx-background-color: #1e3a3a; -fx-background-radius: 8; -fx-padding: 12 16; -fx-cursor: hand;">
                    <graphic>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <ImageView fx:id="iconProduk"
                                       fitWidth="20" fitHeight="20"
                                       preserveRatio="true"/>
                            <Label text="Produk"
                                   style="-fx-text-fill: white; -fx-font-size: 14;"/>
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="btnDataProduksi"
                        maxWidth="Infinity"
                        onAction="#navigasiDataProduksi"
                        style="-fx-background-color: transparent; -fx-background-radius: 8; -fx-padding: 12 16; -fx-cursor: hand;">
                    <graphic>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <ImageView fx:id="iconDataProduksi"
                                       fitWidth="20" fitHeight="20"
                                       preserveRatio="true"/>
                            <Label text="Data Produksi"
                                   style="-fx-text-fill: white; -fx-font-size: 14;"/>
                        </HBox>
                    </graphic>
                </Button>

                <Button fx:id="btnBuatLaporan"
                        maxWidth="Infinity"
                        onAction="#navigasiBuatLaporan"
                        style="-fx-background-color: transparent; -fx-background-radius: 8; -fx-padding: 12 16; -fx-cursor: hand;">
                    <graphic>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <ImageView fx:id="iconLaporan"
                                       fitWidth="20" fitHeight="20"
                                       preserveRatio="true"/>
                            <Label text="Buat Laporan"
                                   style="-fx-text-fill: white; -fx-font-size: 14;"/>
                        </HBox>
                    </graphic>
                </Button>

            </VBox>

            <!-- SPACER BAWAH -->
            <Region VBox.vgrow="ALWAYS"/>

            <!-- TOMBOL KELUAR -->
            <VBox style="-fx-padding: 0 16 32 16;">
                <Button maxWidth="Infinity"
                        onAction="#klikKeluar"
                        style="-fx-background-color: #00e5a0; -fx-background-radius: 8; -fx-padding: 12 16; -fx-cursor: hand;">
                    <graphic>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <ImageView fx:id="iconKeluar"
                                       fitWidth="20" fitHeight="20"
                                       preserveRatio="true"/>
                            <Label text="Keluar"
                                   style="-fx-text-fill: #0a1f1f; -fx-font-size: 14; -fx-font-weight: bold;"/>
                        </HBox>
                    </graphic>
                </Button>
            </VBox>

        </VBox>
    </left>

    <!-- CONTENT AREA -->
    <center>
        <StackPane fx:id="contentArea"/>
    </center>

</BorderPane>