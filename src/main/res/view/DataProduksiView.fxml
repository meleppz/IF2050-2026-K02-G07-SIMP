<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="view.DataProduksiViewController"
            style="-fx-background-color: #0a1f1f; -fx-font-family: 'Plus Jakarta Sans';">

    <!-- HEADER -->
    <top>
        <HBox alignment="CENTER_LEFT" style="-fx-padding: 24 32;" spacing="12">

            <!-- KIRI: judul + divider + tombol -->
            <Label text="Data Produksi"
                   style="-fx-text-fill: #00e5a0; -fx-font-size: 28; -fx-font-weight: bold;"/>
            <Label text="|"
                   style="-fx-text-fill: #1e3a3a; -fx-font-size: 28; -fx-padding: 0 8;"/>
            <Button text="Tambah Data Produksi Baru"
                    fx:id="btnTambahProduksi"
                    onAction="#klikTambahProduksi"
                    style="-fx-background-color: #00e5a0; -fx-text-fill: #0a1f1f; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 20; -fx-cursor: hand;"/>

            <!-- SPACER -->
            <Region HBox.hgrow="ALWAYS"/>

            <!-- KANAN: bel + avatar + teks -->
            <HBox alignment="CENTER" spacing="12">
                <Button style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 4;">
                    <graphic>
                        <ImageView fitWidth="24" fitHeight="24" preserveRatio="true">
                            <image>
                                <Image url="/images/icon_bell.png"/>
                            </image>
                        </ImageView>
                    </graphic>
                </Button>

                <ImageView fitWidth="40" fitHeight="40" preserveRatio="true">
                    <image>
                        <Image url="/images/avatar_default.jpg"/>
                    </image>
                </ImageView>

                <VBox alignment="CENTER_LEFT" spacing="2">
                    <Label text="Selamat Datang"
                           style="-fx-text-fill: #5a8a8a; -fx-font-size: 11;"/>
                    <Label fx:id="lblNamaPengguna"
                           text="Lorem Ipsum"
                           style="-fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold;"/>
                </VBox>
            </HBox>

        </HBox>
    </top>

    <!-- CONTENT -->
    <center>
        <VBox spacing="16" style="-fx-padding: 0 32 32 32;">

            <!-- SEARCH BAR + FILTER -->
            <HBox spacing="12" alignment="CENTER_LEFT">
                <StackPane HBox.hgrow="ALWAYS">
                    <TextField fx:id="fieldCariProduksi"
                               promptText="Cari Nama Produk atau ID..."
                               onKeyReleased="#updateFilterDanSort"
                               style="-fx-background-color: #132929; -fx-text-fill: white; -fx-prompt-text-fill: #5a8a8a; -fx-background-radius: 8; -fx-padding: 12 48 12 16; -fx-font-size: 14;"/>
                    <ImageView fitWidth="18" fitHeight="18" preserveRatio="true" StackPane.alignment="CENTER_RIGHT">
                        <StackPane.margin><Insets right="15"/></StackPane.margin>
                        <image><Image url="/images/icon_search.png"/></image>
                    </ImageView>
                </StackPane>

                <ComboBox fx:id="comboFilterKategori" promptText="Semua Kategori" onAction="#updateFilterDanSort"
                          minWidth="150" style="-fx-background-color: #132929; -fx-text-fill: white; -fx-text-base-color: white; -fx-background-radius: 8; -fx-padding: 8;"/>

                <ComboBox fx:id="comboSort" promptText="Urutkan" onAction="#updateFilterDanSort"
                          minWidth="150" style="-fx-background-color: #132929; -fx-text-fill: white; -fx-text-base-color: white; -fx-background-radius: 8; -fx-padding: 8;"/>
            </HBox>

            <!-- EMPTY STATE -->
            <VBox fx:id="emptyState" alignment="CENTER" spacing="16"
                  style="-fx-padding: 80 0;">
                <Label text="Uh Oh"
                       style="-fx-text-fill: white; -fx-font-size: 22; -fx-font-weight: bold;"/>
                <Label text="Data produksi masih kosong, ayo tambahkan terlebih dahulu"
                       style="-fx-text-fill: #5a8a8a; -fx-font-size: 14;"/>
                <Button text="Tambah Data Produksi"
                        onAction="#klikTambahProduksi"
                        style="-fx-background-color: #00e5a0; -fx-text-fill: #0a1f1f; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 12 40; -fx-font-size: 14; -fx-cursor: hand;"/>
            </VBox>

            <!-- TABEL -->
            <VBox fx:id="containerTabel" spacing="0" VBox.vgrow="ALWAYS">
                <!-- HEADER TABEL (menggunakan responsive layout) -->
                <HBox style="-fx-background-color: #132929; -fx-padding: 12 16; -fx-background-radius: 8 8 0 0;" alignment="CENTER_LEFT">
                    <Label text="ID" prefWidth="80" alignment="CENTER"
                           style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                    <Label text="Nama Produk" prefWidth="200" alignment="CENTER"
                           style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                    <Label text="Total Produksi" prefWidth="150" alignment="CENTER"
                           style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                    <Label text="Defect" prefWidth="100" alignment="CENTER"
                           style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                    <Label text="Kategori" prefWidth="150" alignment="CENTER"
                           style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                    <Label text="Perubahan Terakhir" prefWidth="200" alignment="CENTER"
                           style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                    <Label text="Aksi" prefWidth="100" alignment="CENTER"
                           style="-fx-text-fill: white; -fx-font-weight: bold;"/>
                </HBox>

                <!-- ISI TABEL -->
                <ScrollPane fx:id="scrollTabel" fitToWidth="true"
                            style="-fx-background: transparent; -fx-background-color: transparent;">
                    <content>
                        <VBox fx:id="isiTabel" style="-fx-spacing: 1;"/>
                    </content>
                </ScrollPane>
            </VBox>

        </VBox>
    </center>

</BorderPane>