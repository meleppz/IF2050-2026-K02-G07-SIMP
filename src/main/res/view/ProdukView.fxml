<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="view.ProdukViewController"
            style="-fx-background-color: #0a1f1f; -fx-font-family: 'Plus Jakarta Sans';">

    <!-- HEADER -->
    <top>
        <HBox alignment="CENTER_LEFT" style="-fx-padding: 24 32 16 32;">

            <!-- KIRI: judul + divider + tombol -->
            <Label text="Produk"
                   style="-fx-text-fill: #00e5a0; -fx-font-size: 28; -fx-font-weight: bold;"/>
            <Label text="|"
                   style="-fx-text-fill: #1e3a3a; -fx-font-size: 28; -fx-padding: 0 16;"/>
            <Button text="Tambah Produk Baru"
                    fx:id="btnTambahProduk"
                    onAction="#klikTambahProduk"
                    style="-fx-background-color: #00e5a0; -fx-text-fill: #0a1f1f; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 20; -fx-cursor: hand;"/>

            <!-- SPACER -->
            <Region HBox.hgrow="ALWAYS"/>

            <!-- KANAN: bel + avatar + teks -->
            <HBox alignment="CENTER" spacing="12">
                <Button style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 4;">
                    <graphic>
                        <ImageView fitWidth="24" fitHeight="24" preserveRatio="true">
                            <image>
                                <Image url="/images/icon_bell.png"/>
                            </image>
                        </ImageView>
                    </graphic>
                </Button>

                <ImageView fitWidth="40" fitHeight="40" preserveRatio="true">
                    <image>
                        <Image url="/images/avatar_default.jpg"/>
                    </image>
                </ImageView>

                <VBox alignment="CENTER_LEFT" spacing="2">
                    <Label text="Selamat Siang"
                           style="-fx-text-fill: #5a8a8a; -fx-font-size: 11;"/>
                    <Label text="Lorem Ipsum"
                           style="-fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold;"/>
                </VBox>
            </HBox>

        </HBox>
    </top>

    <!-- CONTENT -->
    <center>
        <VBox spacing="16" style="-fx-padding: 0 32 32 32;">

            <!-- SEARCH BAR + FILTER -->
            <HBox spacing="12" alignment="CENTER_LEFT">

                <!-- SEARCH BOX -->
                <StackPane HBox.hgrow="ALWAYS">
                    <TextField fx:id="fieldCariProduk"
                               promptText="Cari Produk"
                               onKeyReleased="#cariProduk"
                               style="-fx-background-color: #132929; -fx-text-fill: white; -fx-prompt-text-fill: #5a8a8a; -fx-background-radius: 8; -fx-padding: 12 48 12 16; -fx-font-size: 14;"/>
                    <Button style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 0 12 0 0;"
                            StackPane.alignment="CENTER_RIGHT">
                        <graphic>
                            <ImageView fitWidth="18" fitHeight="18" preserveRatio="true">
                                <image>
                                    <Image url="/images/icon_search.png"/>
                                </image>
                            </ImageView>
                        </graphic>
                    </Button>
                </StackPane>

                <!-- FILTER BUTTON -->
                <Button style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 0; -fx-min-width: 0; -fx-min-height: 0; -fx-pref-width: 20; -fx-pref-height: 20;">
                    <graphic>
                        <ImageView fitWidth="20" fitHeight="20" preserveRatio="true">
                            <image>
                                <Image url="/images/icon_filter.png"/>
                            </image>
                        </ImageView>
                    </graphic>
                </Button>

            </HBox>

            <!-- EMPTY STATE -->
            <VBox fx:id="emptyState" alignment="CENTER" spacing="16"
                  style="-fx-padding: 80 0;">
                <Label text="Uh Oh"
                       style="-fx-text-fill: white; -fx-font-size: 22; -fx-font-weight: bold;"/>
                <Label text="Produk masih kosong, ayo tambahkan terlebih dahulu"
                       style="-fx-text-fill: #5a8a8a; -fx-font-size: 14;"/>
                <Button text="Tambah Produk"
                        onAction="#klikTambahProduk"
                        style="-fx-background-color: #00e5a0; -fx-text-fill: #0a1f1f; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 12 40; -fx-font-size: 14; -fx-cursor: hand;"/>
            </VBox>

            <!-- GRID PRODUK -->
            <ScrollPane fx:id="scrollProduk" fitToWidth="true"
                        style="-fx-background: transparent; -fx-background-color: transparent;">
                <content>
                    <FlowPane fx:id="gridProduk" hgap="16" vgap="16"/>
                </content>
            </ScrollPane>

        </VBox>
    </center>

</BorderPane>