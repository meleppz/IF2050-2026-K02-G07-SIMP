<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      spacing="16"
      style="-fx-background-color: #0d2626; -fx-padding: 24; -fx-background-radius: 12; -fx-font-family: 'Plus Jakarta Sans';"
      prefWidth="500">

    <Label fx:id="labelJudulForm"
           text="Tambah Produk Baru"
           style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;"/>

    <Separator style="-fx-background-color: #1e3a3a;"/>

    <!-- FOTO -->
    <HBox spacing="16" alignment="CENTER_LEFT">
        <StackPane fx:id="containerFoto"
                   prefWidth="160" prefHeight="160"
                   style="-fx-background-color: #c0c0c0; -fx-background-radius: 8;">
            <!-- placeholder icon, disembunyikan kalau sudah ada foto -->
            <Label fx:id="labelPlaceholderFoto"
                   text="🖼"
                   style="-fx-font-size: 48; -fx-text-fill: #888888;"/>
            <ImageView fx:id="previewFoto"
                       fitWidth="160" fitHeight="160"
                       preserveRatio="true"
                       visible="false"/>
        </StackPane>
        <Button text="Unggah Gambar"
                onAction="#klikUnggahGambar"
                style="-fx-background-color: #1e3a3a; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 20;"/>
    </HBox>

    <!-- KODE PRODUK -->
    <VBox spacing="6">
        <Label text="Kode Produk"
               style="-fx-text-fill: white; -fx-font-size: 13; -fx-font-family: 'Plus Jakarta Sans';"/>
        <TextField fx:id="fieldKodeProduk"
                   promptText="Kode produk..."
                   style="-fx-background-color: #132929; -fx-text-fill: white; -fx-prompt-text-fill: #5a8a8a; -fx-background-radius: 8; -fx-padding: 10 14;"/>
    </VBox>

    <HBox spacing="12">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Nama Produk"
                   style="-fx-text-fill: white; -fx-font-size: 13;"/>
            <TextField fx:id="fieldNamaProduk"
                       promptText="Nama produk..."
                       style="-fx-background-color: #132929; -fx-text-fill: white; -fx-prompt-text-fill: #5a8a8a; -fx-background-radius: 8; -fx-padding: 10 14;"/>
        </VBox>
        <VBox spacing="6" prefWidth="140">
            <Label text="Satuan"
                   style="-fx-text-fill: white; -fx-font-size: 13;"/>
            <TextField fx:id="fieldSatuan"
                       promptText="Satuan..."
                       style="-fx-background-color: #132929; -fx-text-fill: white; -fx-prompt-text-fill: #5a8a8a; -fx-background-radius: 8; -fx-padding: 10 14;"/>
        </VBox>
    </HBox>

    <VBox spacing="6">
        <Label text="Kategori Produk"
               style="-fx-text-fill: white; -fx-font-size: 13;"/>
        <ComboBox fx:id="combKategori"
                  promptText="Ketik atau pilih kategori..."
                  maxWidth="Infinity"
                  editable="true"
                  style="-fx-background-color: #132929; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-family: 'Plus Jakarta Sans';"/>
    </VBox>

    <VBox spacing="6">
        <Label text="Deskripsi Produk"
               style="-fx-text-fill: white; -fx-font-size: 13;"/>
        <TextField fx:id="fieldDeskripsi"
                   promptText="Deskripsi..."
                   style="-fx-background-color: #132929; -fx-text-fill: white; -fx-prompt-text-fill: #5a8a8a; -fx-background-radius: 8; -fx-padding: 10 14;"/>
    </VBox>

    <VBox spacing="6">
        <Label text="Target Produksi per Bulan"
               style="-fx-text-fill: white; -fx-font-size: 13;"/>
        <TextField fx:id="fieldTargetPerBulan"
                   promptText="Jumlah target..."
                   style="-fx-background-color: #132929; -fx-text-fill: white; -fx-prompt-text-fill: #5a8a8a; -fx-background-radius: 8; -fx-padding: 10 14;"/>
    </VBox>

    <Button fx:id="btnLanjut"
            text="Lanjut"
            maxWidth="Infinity"
            onAction="#simpanProduk"
            style="-fx-background-color: #00e5a0; -fx-text-fill: #0a1f1f; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 12; -fx-font-size: 14; -fx-cursor: hand;"/>

</VBox>