<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="view.EksporLaporanView"
           style="-fx-background-color: #0a1f1f;">

    <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;">
        <VBox fx:id="panelForm" spacing="25" style="-fx-padding: 30;">

            <HBox alignment="CENTER_LEFT">
                <Label text="Ekspor Laporan Produksi" style="-fx-text-fill: #00e5a0; -fx-font-size: 26; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS" />
                <VBox alignment="CENTER_RIGHT" spacing="2">
                    <Label text="Selamat Datang" style="-fx-text-fill: #5a8a8a; -fx-font-size: 11;"/>
                    <Label fx:id="lblNamaPengguna" text="Lorem Ipsum" style="-fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: bold;"/>
                </VBox>
            </HBox>

            <VBox spacing="10" style="-fx-background-color: #132929; -fx-padding: 20; -fx-background-radius: 16; -fx-border-color: #1e3a3a; -fx-border-radius: 16;">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="1. Pilih Produk" style="-fx-text-fill: white; -fx-font-size: 15; -fx-font-weight: bold;"/>
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnSemuaProduk" text="Pilih Semua Produk" onAction="#klikSemuaProduk"
                            style="-fx-background-color: transparent; -fx-text-fill: #00e5a0; -fx-border-color: #00e5a0; -fx-border-radius: 16; -fx-cursor: hand; -fx-font-size: 11; -fx-padding: 5 15;"/>
                </HBox>

                <HBox spacing="12">
                    <StackPane HBox.hgrow="ALWAYS">
                        <TextField fx:id="fieldCariProduk" promptText="Cari nama atau kode produk..."
                                   style="-fx-background-color: #0a1f1f; -fx-text-fill: white; -fx-padding: 10 40 10 15; -fx-background-radius: 12; -fx-border-color: #1e3a3a; -fx-border-radius: 12;"/>
                        <ImageView fitWidth="16" fitHeight="16" preserveRatio="true" StackPane.alignment="CENTER_RIGHT">
                            <StackPane.margin><Insets right="15"/></StackPane.margin>
                            <image><Image url="/images/icon_search.png"/></image>
                        </ImageView>
                    </StackPane>

                    <ComboBox fx:id="comboFilterKategori" promptText="Semua Kategori" prefWidth="200"
                              style="-fx-background-color: #132929; -fx-text-fill: white; -fx-text-base-color: white; -fx-background-radius: 8; -fx-padding: 8;"/>
                </HBox>

                <ScrollPane fitToHeight="true" vbarPolicy="NEVER" hbarPolicy="AS_NEEDED"
                            style="-fx-background-color: #132929; -fx-text-fill: white; -fx-text-base-color: white; -fx-background-radius: 8; -fx-padding: 8;"/>
                    <HBox fx:id="listProdukHorizontal" spacing="15" style="-fx-padding: 5 0;">
                    </HBox>
                </ScrollPane>
            </VBox>

            <HBox spacing="20">
                <VBox spacing="12" HBox.hgrow="ALWAYS" style="-fx-background-color: #132929; -fx-padding: 24; -fx-background-radius: 16; -fx-border-color: #1e3a3a; -fx-border-radius: 16;">
                    <Label text="2. Rentang Waktu" style="-fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold;"/>
                    <HBox spacing="8">
                        <Button fx:id="btn7Hari" text="7 Hari" onAction="#klik7Hari" style="-fx-background-color: #1e3a3a; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 6 15; -fx-cursor: hand;"/>
                        <Button fx:id="btn30Hari" text="30 Hari" onAction="#klik30Hari" style="-fx-background-color: #1e3a3a; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 6 15; -fx-cursor: hand;"/>
                        <Button fx:id="btn6Bulan" text="6 Bulan" onAction="#klik6Bulan" style="-fx-background-color: #1e3a3a; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 6 15; -fx-cursor: hand;"/>
                        <Button fx:id="btnSemuaData" text="Semua" onAction="#klikSemuaData" style="-fx-background-color: #1e3a3a; -fx-text-fill: white; -fx-background-radius: 20; -fx-padding: 6 15; -fx-cursor: hand;"/>
                    </HBox>
                    <HBox spacing="15">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Dari Tanggal" style="-fx-text-fill: #5a8a8a; -fx-font-size: 11;"/>
                            <DatePicker fx:id="fieldTglMulai" maxWidth="Infinity" style="-fx-background-color: #0a1f1f;"/>
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Sampai Tanggal" style="-fx-text-fill: #5a8a8a; -fx-font-size: 11;"/>
                            <DatePicker fx:id="fieldTglSelesai" maxWidth="Infinity" style="-fx-background-color: #0a1f1f;"/>
                        </VBox>
                    </HBox>
                </VBox>

                <VBox spacing="12" prefWidth="300" style="-fx-background-color: #132929; -fx-padding: 24; -fx-background-radius: 16; -fx-border-color: #1e3a3a; -fx-border-radius: 16;">
                    <Label text="3. Format Laporan" style="-fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold;"/>
                    <Region VBox.vgrow="ALWAYS" />
                    <Label text="Pilih Ekstensi File" style="-fx-text-fill: #5a8a8a; -fx-font-size: 11;"/>
                    <ComboBox fx:id="comboFormat" maxWidth="Infinity"
                              style="-fx-background-color: #0a1f1f; -fx-background-radius: 12; -fx-border-color: #1e3a3a; -fx-border-radius: 12; -fx-padding: 8;"/>
                    <Region VBox.vgrow="ALWAYS" />
                </VBox>
            </HBox>

            <Button text="Buat Laporan Sekarang" onAction="#klikBuatLaporan" maxWidth="Infinity" prefHeight="55"
                    style="-fx-background-color: #00e5a0; -fx-text-fill: #0a1f1f; -fx-font-weight: bold; -fx-font-size: 16; -fx-background-radius: 16; -fx-cursor: hand; -fx-effect: dropshadow(three-pass-box, rgba(0,229,160,0.2), 10, 0, 0, 0);"/>
        </VBox>
    </ScrollPane>

    <VBox fx:id="panelLoading" alignment="CENTER" spacing="20" visible="false" managed="false" style="-fx-background-color: rgba(10, 31, 31, 0.8);">
        <ProgressIndicator fx:id="progressBar" prefHeight="80" prefWidth="80" />
        <Label text="Sedang memproses data..." style="-fx-text-fill: white; -fx-font-size: 16;"/>
    </VBox>

    <VBox fx:id="panelHasil" alignment="CENTER" spacing="25" visible="false" managed="false">
        <VBox alignment="CENTER" spacing="5">
            <Label text="Laporan Siap Diunduh" style="-fx-text-fill: #00e5a0; -fx-font-size: 24; -fx-font-weight: bold;"/>
            <Label fx:id="labelFormatHasil" text="Format: PDF" style="-fx-text-fill: #5a8a8a; -fx-font-size: 16;"/>
        </VBox>
        <HBox alignment="CENTER" spacing="15">
            <Button text="Simpan File Ke Perangkat" onAction="#klikUnduhLaporan" prefHeight="50" style="-fx-background-color: #00e5a0; -fx-padding: 0 40; -fx-background-radius: 12; -fx-text-fill: #0a1f1f; -fx-font-weight: bold; -fx-cursor: hand;"/>
            <Button text="Buat Lagi" onAction="#klikBuatLaporanLain" prefHeight="50" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-border-color: #5a8a8a; -fx-border-radius: 12; -fx-padding: 0 30; -fx-cursor: hand;"/>
        </HBox>
    </VBox>

</StackPane>